# Data — never commit the corpus or derived stores.
# `data/*` rather than `data/`: git will not descend into an ignored directory,
# so the negation below would otherwise never apply.
data/*
!data/.gitkeep
corpus/
blobs/
chroma/
*.pdf
!backend/tests/fixtures/**/*.pdf

