# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment
.env
.env.local
.env.*.local

# Data — never commit the corpus or derived stores.
# `data/*` rather than `data/`: git will not descend into an ignored directory,
# so the negation below would otherwise never apply.
data/*
!data/.gitkeep
# A pattern containing a slash is anchored to this file's directory, so the
# rule above does NOT cover backend/data/. Model caches landed there when the
# app was run from backend/, and git happily committed a tree of symlinks
# pointing at blobs it had been told to ignore.
backend/data/
**/data/models/
documents/
reports/
backups/
corpus/
blobs/
chroma/
*.pdf
!backend/tests/fixtures/**/*.pdf

# Models cache
.models/
.cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
