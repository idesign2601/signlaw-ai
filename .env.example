# =============================================================================
# SignLaw AI — environment configuration
#
# Copy to `.env` and adjust. Nested settings use a DOUBLE underscore
# delimiter: LLM__PROVIDER maps to settings.llm.provider.
#
# Defaults are LOCAL-FIRST: Ollama + Qwen for generation, BGE-M3 for
# embeddings. Nothing leaves the machine unless you switch a provider
# to `openai` / `anthropic` below.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=SignLaw AI
ENVIRONMENT=local                  # local | dev | staging | production
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# --- Database (Postgres) -----------------------------------------------------
DB__HOST=localhost                 # `postgres` when running under docker compose
DB__PORT=5432
DB__USER=signlaw
DB__PASSWORD=change-me-in-production
DB__NAME=signlaw
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__ECHO=false

# --- Redis (ingestion job queue) ---------------------------------------------
REDIS__HOST=localhost              # `redis` under docker compose
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

# --- LLM ---------------------------------------------------------------------
# provider: ollama | openai | anthropic
LLM__PROVIDER=ollama
LLM__MODEL=qwen2.5:14b-instruct
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=2048
LLM__REQUEST_TIMEOUT_S=120
LLM__MAX_RETRIES=3
LLM__OLLAMA_BASE_URL=http://localhost:11434
# Only needed if LLM__PROVIDER=openai
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=
# Only needed if LLM__PROVIDER=anthropic
LLM__ANTHROPIC_API_KEY=

# --- Embeddings --------------------------------------------------------------
# provider: local | openai
EMBEDDING__PROVIDER=local
EMBEDDING__MODEL=BAAI/bge-m3
EMBEDDING__DIMENSIONS=1024
EMBEDDING__BATCH_SIZE=32           # 128 on a 24GB GPU
EMBEDDING__DEVICE=auto             # auto | cpu | cuda | cuda:N | mps
EMBEDDING__OPENAI_API_KEY=

# --- GPU deployment (see docs/DEPLOYMENT.md) ---------------------------------
# Used only with:  docker compose -f docker-compose.yml -f docker-compose.gpu.yml
# TORCH_VARIANT controls image size: cpu installs the CPU-only torch wheel
# (~2GB smaller); cuda takes the PyPI wheel with the bundled CUDA runtime.
TORCH_VARIANT=cpu                  # cpu | cuda
# Keeps the model resident so the first question after idle does not pay a
# 10-30s load, which would otherwise land in your answer-latency measurement.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1

# --- Vector store (pgvector, inside the Postgres above) ----------------------
# Collection name is derived: <prefix>_<model slug>_v<index version>
#   e.g. signlaw_bge_m3_v1
VECTOR__COLLECTION_PREFIX=signlaw
VECTOR__INDEX_VERSION=1
# Bump when chunking rules change. A new embedding model does NOT require
# re-chunking; a new chunking version does.
VECTOR__CHUNKING_VERSION=1
VECTOR__DISTANCE_METRIC=cosine     # cosine | l2 | ip
VECTOR__HNSW_M=16
VECTOR__HNSW_EF_CONSTRUCTION=64
VECTOR__HNSW_EF_SEARCH=100

# --- Ingestion ---------------------------------------------------------------
INGESTION__CORPUS_DIR=./data/corpus
INGESTION__BLOB_DIR=./data/blobs
INGESTION__MAX_FILE_SIZE_MB=200
INGESTION__CONCURRENCY=4
# A page with fewer extractable characters than this is treated as scanned.
INGESTION__SCAN_DETECTION_MIN_CHARS=120
INGESTION__OCR_ENABLED=true
# '+'-separated Tesseract language codes, e.g. eng or eng+fra
INGESTION__OCR_LANGUAGES=eng
INGESTION__OCR_DPI=300
# Trained OCR models. Populated by `make fetch-models`; never baked into images.
INGESTION__TESSDATA_DIR=./data/models/tessdata
INGESTION__CHUNK_TARGET_TOKENS=700
INGESTION__CHUNK_OVERLAP_TOKENS=80
INGESTION__CHUNK_MAX_TOKENS=1200

# --- Retrieval ---------------------------------------------------------------
# pgvector top 50 + Postgres full-text top 50 -> fuse -> rerank -> top 5 -> LLM
RETRIEVAL__DENSE_TOP_K=50
RETRIEVAL__SPARSE_TOP_K=50
RETRIEVAL__CANDIDATE_POOL_SIZE=50
# Relative trust in each retriever during fusion. Bylaw queries are full of
# exact terms that dense embeddings blur, so sparse is weighted equally.
RETRIEVAL__DENSE_WEIGHT=0.5
RETRIEVAL__SPARSE_WEIGHT=0.5
RETRIEVAL__RRF_K=60
RETRIEVAL__RERANK_ENABLED=true
RETRIEVAL__RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL__RERANK_TOP_N=5
RETRIEVAL__MIN_RELEVANCE_SCORE=0.15
RETRIEVAL__ABSTAIN_BELOW_CONFIDENCE=0.35
# Restrict retrieval to documents believed to be in force.
RETRIEVAL__IN_FORCE_ONLY=true

# --- Security ----------------------------------------------------------------
# Both required when ENVIRONMENT=production. Generate: openssl rand -hex 32
#
# ADMIN_API_KEY guards document management; API_KEYS guards asking questions.
# Different secrets on purpose: one lets a client ask, the other lets someone
# change what the answers are made of.
SECURITY__ADMIN_API_KEY=

# A JSON array, even for a single key — list-valued settings are JSON-decoded
# straight from the file, so a bare value fails to parse. Several keys let one
# client be revoked without disrupting the others:
#   SECURITY__API_KEYS=["key-for-the-website","key-for-the-mobile-app"]
SECURITY__API_KEYS=[]

SECURITY__CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SECURITY__RATE_LIMIT_PER_MINUTE=60

# --- Observability -----------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR
OBSERVABILITY__LOG_FORMAT=console  # console | json  (use json in production)
OBSERVABILITY__LOG_SQL=false
